# ============================================================
# 职路AI - 生产环境配置
# 部署时请将此文件复制为 .env.production 并填写实际值
# 仅提交此模板，实际配置保存在本地 .env.production
# ============================================================

# --- 应用基础配置 ---
ENVIRONMENT=production
DEBUG=False
PROJECT_NAME=职路AI
VERSION=0.1.0
API_PREFIX=/api/v1
SECRET_KEY=change-this-to-a-random-secret-key-in-production

# --- AI服务配置 ---
AI_PROVIDER=openai
AI_API_KEY=
# 留空时按 AI_PROVIDER 选择默认地址和模型
# AI_API_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-3.5-turbo
AI_TIMEOUT=30

# 提供商预设配置（取消注释即可切换）
# --- 通义千问 (DashScope) ---
# AI_PROVIDER=dashscope
# AI_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# AI_MODEL=qwen-turbo

# --- 智谱 AI ---
# AI_PROVIDER=zhipu
# AI_API_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# AI_MODEL=glm-4-flash

# --- 数据存储 ---
DATA_DIR=./data
LOG_DIR=./logs

# --- 日志配置 ---
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_ROTATION_DAYS=30

# --- CORS 安全配置 ---
CORS_ORIGINS=["https://yourdomain.com"]
CORS_ALLOW_CREDENTIALS=True

# --- 安全配置 ---
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
SECURITY_HEADERS_X_CONTENT_TYPE=True
SECURITY_HEADERS_X_FRAME_OPTIONS=DENY
SECURITY_HEADERS_X_XSS_PROTECTION=True
